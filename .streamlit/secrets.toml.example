# Modelo do arquivo de segredos. Copie para `.streamlit/secrets.toml`,
# preencha a senha e NÃO versione o arquivo copiado (ele está no .gitignore).
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# No Streamlit Community Cloud, o conteúdo abaixo vai em
# Settings > Secrets, no painel do app. Não é preciso criar arquivo lá.

senha = "troque-por-uma-senha-forte"
